<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        This is US — the parent of all 22 services.
        groupId    = our company/project namespace
        artifactId = this specific module's name
        version    = all child modules inherit this version
        packaging  = pom means this module produces no JAR.
                     It exists only to be inherited from.
    -->
    <groupId>com.shopsphere</groupId>
    <artifactId>shopsphere-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
        We inherit from Spring Boot's parent.
        WHY: Spring Boot's parent already manages versions for
        300+ libraries. We get all of that for free.
        We don't need to manage Jackson, SLF4J, HikariCP versions.
        Spring Boot's team already figured out which versions
        work well together.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!--
        All 22 services listed here.
        ORDER MATTERS — shared modules must come before services
        because services depend on them at compile time.
        Maven builds them top to bottom.
    -->
    <modules>
        <!-- Build shared libraries first -->
        <module>shared/common-dtos</module>
        <module>shared/common-exceptions</module>
        <module>shared/common-utils</module>
        <module>shared/common-events</module>

        <!-- Infrastructure -->
        <module>services/infrastructure-services/config-server</module>
        <module>services/infrastructure-services/service-registry</module>

        <!-- Gateway -->
        <module>services/api-gateway</module>

        <!-- Identity -->
        <!-- <module>services/identity-services/auth-service</module>
        <module>services/identity-services/user-service</module> -->
        <!-- <module>services/identity-services/admin-service</module>
        <module>services/identity-services/vendor-service</module> -->

        <!-- Products -->
        <module>services/product-services/product-service</module>
        <module>services/product-services/inventory-service</module>
        <module>services/product-services/search-service</module>
        <!-- <module>services/product-services/review-service</module> -->

        <!-- Orders -->
        <module>services/order-services/order-service</module>
        <module>services/order-services/payment-service</module>
        <!-- <module>services/order-services/discount-service</module>
        <module>services/order-services/shipping-service</module>
        <module>services/order-services/return-refund-service</module> -->

        <!-- Vendor -->
        <!-- <module>services/vendor-services/vendor-product-service</module>
        <module>services/vendor-services/vendor-payout-service</module>
        <module>services/vendor-services/vendor-analytics-service</module> -->

        <!-- Support -->
        <module>services/support-services/notification-service</module>
        <!-- <module>services/support-services/admin-analytics-service</module>
        <module>services/support-services/content-banner-service</module> -->
    </modules>

    <!--
        Version variables. This is the single source of truth.
        If Kafka releases 3.8.0, you change ONE line here.
        All 22 services pick it up on next build.
    -->
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            Spring Cloud version MUST match Spring Boot version.
            Spring Boot 3.2.x → Spring Cloud 2023.0.x
            Mismatch here = runtime failures that look completely unrelated.
            Always check the compatibility matrix before upgrading either.
        -->
        <spring-cloud.version>2023.0.1</spring-cloud.version>

        <postgresql.version>42.7.3</postgresql.version>
        <flyway.version>10.10.0</flyway.version>
        <jjwt.version>0.12.5</jjwt.version>
        <lombok.version>1.18.32</lombok.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <springdoc.version>2.5.0</springdoc.version>
        <testcontainers.version>1.19.8</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Spring Cloud BOM.
                BOM = Bill of Materials. It's a special POM that only
                declares versions — no actual code.
                Importing it means we get managed versions for:
                Eureka, Gateway, Config Server, OpenFeign, Circuit Breaker.
                We import it rather than inherit because Maven only
                allows one <parent>. We're already using Spring Boot as parent.
            -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers BOM — same pattern as Spring Cloud -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Shared modules — version managed here so child services
                 don't hardcode their sibling module versions -->
            <dependency>
                <groupId>com.shopsphere</groupId>
                <artifactId>common-dtos</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shopsphere</groupId>
                <artifactId>common-exceptions</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shopsphere</groupId>
                <artifactId>common-utils</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shopsphere</groupId>
                <artifactId>common-events</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Database -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- JWT — three artifacts, same version, all managed here -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- API documentation -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- MapStruct — DTO ↔ Entity mapping -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        These three go into EVERY service automatically.
        No service needs to declare them.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Actuator gives every service /actuator/health and
            /actuator/prometheus endpoints.
            Kubernetes needs /health for liveness and readiness probes.
            Prometheus needs /actuator/prometheus to scrape metrics.
            Without this, your service cannot be properly monitored
            or managed in a cluster.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>9.2.0</version>
                    <configuration>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <suppressionFile>${project.basedir}/owasp-suppressions.xml</suppressionFile>
                        <formats>HTML,JSON</formats>
                        <outputDirectory>${project.build.directory}/dependency-check-report</outputDirectory>
                        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        <!-- Skip test-scope dependencies — they never reach production -->
                        <skipTestScope>true</skipTestScope>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!--
                    Lombok and MapStruct both use annotation processors.
                    They run at compile time to generate code.
                    Lombok generates getters/setters/constructors.
                    MapStruct generates mapper implementations.
                    
                    THE ORDER IS CRITICAL:
                    Lombok must run FIRST because MapStruct's generated
                    code calls the getters/setters that Lombok generates.
                    If MapStruct runs first, those methods don't exist yet
                    and compilation fails with confusing errors.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
    <!-- Activate with: mvn verify -Powasp
         Or in CI via: mvn dependency-check:aggregate -Powasp
         Kept as a profile so normal mvn verify stays fast locally -->
    <profile>
        <id>owasp</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <!-- aggregate scans ALL modules in one run
                                     instead of scanning each service separately -->
                                <goal>aggregate</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </build>
    </profile>
</profiles>

</project>