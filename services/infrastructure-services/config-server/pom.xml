<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shopsphere</groupId>
        <artifactId>shopsphere-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
        <!--
            Three levels up: config-server → infrastructure-services → services → root
        -->
    </parent>

    <artifactId>config-server</artifactId>
    <packaging>jar</packaging>
    <name>ShopSphere Config Server</name>

    <dependencies>
        <!--
            This single dependency is all you need.
            spring-cloud-config-server includes:
              - Embedded Tomcat (it's a web server)
              - Spring Cloud Config Server core
              - Git backend support (JGit library)
              - Actuator (health endpoints)
            No database. No Kafka. Config Server is intentionally simple.
            The simpler it is, the less that can go wrong with the
            service everything else depends on.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-config-server</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>