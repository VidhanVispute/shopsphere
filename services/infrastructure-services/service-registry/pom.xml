<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shopsphere</groupId>
        <artifactId>shopsphere-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>service-registry</artifactId>
    <packaging>jar</packaging>
    <name>ShopSphere Service Registry</name>

    <dependencies>
        <!--
            Eureka Server dependency.
            This single dependency gives you:
              - The Eureka registry (stores service instances)
              - The Eureka dashboard (web UI at /eureka)
              - REST API for registration and discovery
              - Self-preservation mode
            
            Notice: no database dependency.
            Eureka stores the registry IN MEMORY only.
            WHY: Registry data is ephemeral — services re-register
            on every restart anyway. Persisting it adds complexity
            with no real benefit. Speed of lookup matters more
            than durability of the registry.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>

        <!--
            Config Client — Service Registry itself fetches its config
            from Config Server on startup.
            WHY: Even infrastructure services use centralized config.
            This means if you change the Eureka port or self-preservation
            threshold, you change it in the config repo — not in the code.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!--
            Bootstrap dependency needed for Spring Cloud Config in Spring Boot 3.x.
            WHY: In Spring Boot 2.x, bootstrap.yml was automatically loaded
            before application.yml. In Spring Boot 3.x this was removed.
            This dependency restores that behavior so the service knows
            where to find Config Server before it loads its own config.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>