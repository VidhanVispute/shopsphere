<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shopsphere</groupId>
        <artifactId>shopsphere-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-exceptions</artifactId>
    <packaging>jar</packaging>
    <name>ShopSphere Common Exceptions</name>

    <dependencies>

        <!--
            common-exceptions depends on common-dtos because
            GlobalExceptionHandler wraps errors inside ApiResponse.
            Without this, the compiler cannot find ApiResponse at all —
            it doesn't matter that both modules are in the same repo.
            Maven resolves dependencies from the local repository (~/.m2),
            not from the filesystem directly.
        -->
        <dependency>
            <groupId>com.shopsphere</groupId>
            <artifactId>common-dtos</artifactId>
            <!--
                No <version> tag here — intentional.
                The version is managed in the parent POM's
                <dependencyManagement> section.
                This is the rule: declare WHAT you need,
                parent decides WHICH version.
            -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

    </dependencies>

</project>